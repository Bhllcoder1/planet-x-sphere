# planet-x-sphere — sunucu ortam değişkenleri
# Bu dosyayı .env olarak kopyala ve doldur: cp .env.example .env
# .env ASLA commit edilmez (.gitignore'da).

# --- Uygulama ---
APP_SECRET_KEY=değiştir_beni_rastgele_32_bayt_hex
APP_ENV=production          # development | production
APP_PORT=8000

# --- Oturum ---
SESSION_COOKIE_NAME=spherex_session
SESSION_MAX_AGE_SECONDS=86400   # 24 saat

# --- Kullanıcılar ---
# Seed dosyası yolu (görev 11-04)
USERS_SEED_FILE=c_sunucu/accounts/users_seed.json

# --- S3 (anonim — anahtar GEREKMİYOR) ---
# S3_BUCKET ve S3_REGION bilgi amaçlıdır, kimlik bilgisi değil.
S3_BUCKET=nasa-irsa-spherex
S3_REGION=us-east-1

# --- Önbellek ---
L0_CACHE_DIR=/data/cache/l0    # frame listesi JSON'ları
L1_CACHE_DIR=/data/cache/l1    # byte-offset haritaları
L2_CACHE_DIR=/data/cache/l2    # pencere dosyaları

# --- Caddy (TLS) ---
CADDY_DOMAIN=localhost          # demo için gerçek alan adı
